# Normalize line endings: store LF in the repo and check out LF on every
# platform, so prettier/gofmt see identical bytes locally and in CI.
* text=auto eol=lf

# Every PR adds its line to the same `## Unreleased` block, so two branches
# that touch it conflict on nearly every merge (58 of 89 commits did in one
# 2026-09-25..28 window). Union merge keeps both sides' added lines instead of
# leaving conflict markers. A malformed result is still caught: prettier and
# scripts/checks/check-doc-counts.mjs read the file.
CHANGELOG.md merge=union

# Every hunt fix appends to the ledger's findings array and bumps nextId, so
# parallel PRs conflict there on every dev merge. The findings-ledger driver
# (scripts/merge-ledger.mjs) merges by finding id and recomputes nextId. Git
# needs it registered per clone: `npm run hooks:install` does that, and the
# Claude Code session-start hook does it in cloud sessions. Without it, git
# falls back to the ordinary text merge.
.superpowers/findings-ledger.json merge=findings-ledger

# Binary assets
*.png binary
*.ico binary
*.wasm binary
*.woff2 binary
*.exe binary

