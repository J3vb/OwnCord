#!/bin/sh
# OwnCord pre-commit hook — fast, staged-file-aware checks that mirror CI's
# cheapest gates so errors surface in seconds instead of a 15-minute CI run.
#
# Enable once per clone:  npm run hooks:install   (git config core.hooksPath .githooks)
# Bypass in an emergency: git commit --no-verify  or  OWNCORD_SKIP_HOOKS=1
# CI still enforces everything — bypassing only defers the failure.

[ "${OWNCORD_SKIP_HOOKS:-0}" = "1" ] && exit 0

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
# Deletions can stale the inventory checks below, so they count as changes.
changed=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$changed" ] && exit 0

fail() {
    printf '\npre-commit: FAIL: %s\n(bypass with --no-verify; CI will still enforce this)\n' "$1" >&2
    exit 1
}

# ---------- Server (Go) ----------
go_staged=$(printf '%s\n' "$staged" | grep '^Server/.*\.go$' | grep -v '^Server/db/dbgen/')
if [ -n "$go_staged" ]; then
    if command -v go >/dev/null 2>&1 && command -v gofmt >/dev/null 2>&1; then
        # Word splitting is intended: repo paths contain no spaces.
        # shellcheck disable=SC2086
        unformatted=$(gofmt -l $go_staged)
        [ -n "$unformatted" ] && fail "gofmt needed (run gofmt -w on): $unformatted"
        (cd Server && go vet ./...) || fail "go vet"
    else
        printf 'pre-commit: WARNING: go/gofmt not installed; skipping Go checks.\n' >&2
    fi
fi

# These two blocks inline what `make sqlc-verify` / `make protocol-verify` reduce
# to (Server/Makefile), rather than shelling out to make. `make` is not on PATH on
# a stock Windows box, and a guard on `go`/`sqlc` does not imply it: the old code
# probed one command and invoked another, so a contributor with Go but no make was
# told "protocol constants are stale" when nothing had been generated or compared.

# sqlc inputs changed -> regenerated db/dbgen must be part of the same commit.
if printf '%s\n' "$staged" | grep -qE '^Server/(db/queries/|migrations/|sqlc\.yaml|sqlc\.version)'; then
    if command -v sqlc >/dev/null 2>&1; then
        (cd Server && sqlc generate && git diff --exit-code db/dbgen) \
            || fail "db/dbgen is stale — run 'sqlc generate' in Server/ and stage the result"
    else
        printf 'pre-commit: WARNING: sqlc not installed; skipping the db/dbgen check. Install the version pinned in Server/sqlc.version. CI will run it.\n' >&2
    fi
fi

# Protocol schema changed -> regenerated Go + TS constants must be in the same commit.
if printf '%s\n' "$staged" | grep -qE '^(protocol/schema\.json|Server/cmd/genprotocol/)'; then
    if command -v go >/dev/null 2>&1; then
        # The diff runs from repo_root, not from Server/: git hooks export
        # GIT_DIR, and with GIT_DIR set and no GIT_WORK_TREE git treats the
        # current directory as the work tree, so a "../" path is rejected as
        # outside the repository. That made every one of these checks abort
        # in a git worktree, which is where this repository's own guidance
        # says to do branch work.
        if ! (cd Server && go run ./cmd/genprotocol) \
            || ! git diff --exit-code Server/ws/message_types.go Server/httperr/codes.go Client/src/lib/protocolTypes.ts; then
            fail "protocol constants are stale — run 'go run ./cmd/genprotocol' in Server/ and stage the result"
        fi
    else
        printf 'pre-commit: WARNING: go not installed; skipping the protocol-constants check. CI will run it.\n' >&2
    fi
fi

# Any api/ or admin/ Go file, the migrations, the config or the generator
# changed -> the regenerated docs index blocks must be part of the same commit.
# The route trigger is deliberately the whole of api/ and admin/: routes are
# registered in router.go, in the *_handler.go files, in client_update.go's
# MountClientUpdateRoute, and in the admin package's own mux — naming files
# individually is how this goes stale.
#
# Inlined like the two blocks above, and for the same reason: make is not on
# PATH on a stock Windows box. -tags otel,wazero is the build the route index
# is generated from; the tool refuses to run without it.
if printf '%s\n' "$staged" | grep -qE '^Server/(api|admin)/.*\.go$|^Server/(migrations/|config/config\.go|cmd/gendocs/)'; then
    if command -v go >/dev/null 2>&1; then
        # Root-relative paths, and the diff outside the subshell — see the
        # GIT_DIR note on the protocol check above.
        if ! (cd Server && go run -tags otel,wazero ./cmd/gendocs) \
            || ! git diff --exit-code docs/api.md docs/schema.md docs/server-configuration.md; then
            fail "generated docs blocks are stale, or a config key is undocumented — if gendocs named keys above, document them in docs/server-configuration.md; otherwise run 'go run -tags otel,wazero ./cmd/gendocs' in Server/ and stage the result"
        fi
    else
        printf 'pre-commit: WARNING: go not installed; skipping the generated-docs check. CI will run it.\n' >&2
    fi
fi

# Findings ledger changed -> it must still be valid. Unlike the two blocks
# above there is nothing to diff: FINDINGS.md is not tracked (RL-07), so a
# stale rendering cannot be committed. --check is the whole gate here, and it
# writes nothing. render-ledger.mjs is Node-stdlib-only, so `node` alone is the
# probe — no node_modules guard, unlike the prettier block below.
if printf '%s\n' "$staged" | grep -qE '^\.superpowers/(findings-ledger\.json|render-ledger\.mjs)$'; then
    if command -v node >/dev/null 2>&1; then
        node .superpowers/render-ledger.mjs --check \
            || fail "findings-ledger.json is invalid — see the INVALID lines above"
    else
        printf 'pre-commit: WARNING: node not installed; skipping the ledger check. CI will run it.\n' >&2
    fi
fi

# check-doc-counts.mjs is Node-stdlib-only: it compares the counts stated in the
# watched summaries (WATCHED in the script) with the findings ledger.
if printf '%s\n' "$changed" | grep -qE '^(docs/|CHANGELOG\.md$|README\.md$|CLAUDE\.md$|\.superpowers/findings-ledger\.json$)'; then
    if command -v node >/dev/null 2>&1; then
        node scripts/check-doc-counts.mjs \
            || fail "a doc states a ledger count the ledger contradicts — update the number named above (or the ledger) and re-stage; check with 'node scripts/check-doc-counts.mjs'"
    else
        printf 'pre-commit: WARNING: node not installed; skipping the doc-counts check. CI will run it.\n' >&2
    fi
fi

# ---------- Inventories (added, changed or deleted files) ----------
# The db-import table in docs/architecture/server-boundaries.md goes stale
# when a Go file starts or stops importing db; CI fails on it.
if printf '%s\n' "$changed" | grep -qE '^Server/.*\.go$|^docs/architecture/server-boundaries\.md$'; then
    if command -v go >/dev/null 2>&1; then
        (cd Server && go test -count=1 ./cmd/dbinventory/) \
            || fail "docs/architecture/server-boundaries.md is stale — paste the output of 'go run ./cmd/dbinventory' (in Server/) between its markers"
    fi
fi

# Every mutated Client/src file must sit in exactly one shard of
# Client/stryker.shard.config.mjs; an added or deleted file breaks the union.
if printf '%s\n' "$changed" | grep -qE '^Client/src/.*\.ts$|^Client/stryker\.(shard\.)?config\.mjs$'; then
    (cd Client && node scripts/check-mutation-shards.mjs) \
        || fail "the mutation shards no longer match Client/src — update Client/stryker.shard.config.mjs"
fi

# ---------- Formatting (repository-wide) ----------
# Prettier is configured once at the repository root (.prettierrc.json) and
# covers every material tracked source, not just client TypeScript.
# --ignore-unknown drops the Go/Rust/binary paths it has no parser for.
if [ -z "$staged" ]; then
    :
elif [ -d node_modules ]; then
    # Word splitting is intended: repo paths contain no spaces.
    # shellcheck disable=SC2086
    npx prettier --check --ignore-unknown $staged || fail "prettier (run: npm run format)"
else
    # A git worktree has no root node_modules; the main checkout's install pins
    # the same prettier as CI, so use its binary.
    main_checkout=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
    if [ -x "$main_checkout/node_modules/.bin/prettier" ]; then
        # shellcheck disable=SC2086
        "$main_checkout/node_modules/.bin/prettier" --check --ignore-unknown $staged || fail "prettier (run: npm run format)"
    else
        printf 'pre-commit: WARNING: node_modules missing at the repository root; skipping prettier.\n' >&2
    fi
fi

# ---------- Client (TypeScript) ----------
ts_staged=$(printf '%s\n' "$staged" | grep -E '^Client/(src|tests)/.*\.ts$' | grep -v '/generated/')
if [ -n "$ts_staged" ]; then
    if [ ! -d Client/node_modules ]; then
        printf 'pre-commit: WARNING: node_modules missing in Client; skipping client checks (run npm install there).\n' >&2
    else
        # Warnings are denied under src/ only: tests/ carries its own
        # pre-existing backlog (512 warnings), which B7-1 does not burn down.
        src_rel=$(printf '%s\n' "$ts_staged" | grep '^Client/src/' | sed 's|^Client/||')
        test_rel=$(printf '%s\n' "$ts_staged" | grep '^Client/tests/' | sed 's|^Client/||')
        cd Client || exit 1
        if [ -n "$src_rel" ]; then
            # shellcheck disable=SC2086
            npx oxlint --deny-warnings $src_rel || fail "oxlint"
        fi
        if [ -n "$test_rel" ]; then
            # shellcheck disable=SC2086
            npx oxlint $test_rel || fail "oxlint"
        fi
        npm run -s typecheck || fail "tsc --noEmit"
        cd "$repo_root" || exit 1
    fi
fi

exit 0
