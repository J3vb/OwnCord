# LiveKit server configuration for OwnCord
# Copy this file to livekit.yaml and fill in your values.
# The LiveKit key and secret are NOT set here: docker-compose.yml passes the
# pair from your .env file (LIVEKIT_API_KEY / LIVEKIT_API_SECRET) to LiveKit.

port: 7880

rtc:
  tcp_port: 7881
  # All WebRTC media on one UDP port. docker-compose.yml pins the same port
  # with flags and publishes it; do not add port_range_start/end here.
  udp_port: 7882

  # LiveKit detects your public IP itself (over STUN) when it starts, so after a
  # dynamic address changes, `docker compose restart livekit` picks up the new
  # one with no edit here. Pin node_ip only when detection cannot work — a
  # tailnet-only host (use its 100.x address) or a network that blocks the
  # lookup — and then REPLACE use_external_ip with it: while use_external_ip is
  # on, LiveKit overwrites node_ip with the detected address. A pinned public
  # IP goes stale silently when the address changes: calls connect and carry no
  # audio.
  use_external_ip: true
  # node_ip: "YOUR_SERVER_PUBLIC_IP"   # comment out use_external_ip if you set this

  # If the server is reachable via both a LAN IP and a public IP (dual-homed),
  # uncomment this so LiveKit also advertises the internal address — clients on
  # the local network then connect via LAN while remote clients use the public
  # address.
  # It only works alongside use_external_ip, which overwrites node_ip.
  # advertise_internal_ip: true

# Optional: have LiveKit post room events to OwnCord so a stale or unexpected
# participant is removed the moment it joins, rather than at OwnCord's next
# once-a-minute check. Uncomment only if LiveKit can reach OwnCord at a URL
# whose TLS certificate it trusts (a self-signed certificate fails every
# delivery), and the sender's address is inside
# server.livekit_webhook_allowed_cidrs. api_key must be your LIVEKIT_API_KEY from .env.
# webhook:
#   api_key: YOUR_API_KEY   # same value as LIVEKIT_API_KEY in .env
#   urls:
#     - https://chat.example.com/api/v1/livekit/webhook

# Speaking-ring detection. These match what OwnCord writes for its own
# generated config; LiveKit's defaults (400ms interval, 2 smoothing intervals,
# active_level 35) light the ring late and only for loud speech.
audio:
  active_level: 45
  min_percentile: 30
  update_interval: 100
  smooth_intervals: 1

logging:
  level: info
