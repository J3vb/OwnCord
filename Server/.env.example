# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# LiveKit credentials — generate strong random values (min 32 chars for secret).
# The server refuses the change-me placeholders below and keeps voice off.
# Typed only here: docker-compose.yml passes this pair to both containers
# (the server and LiveKit), so livekit.yaml has no keys: section.
# Never use a ' in either value: LiveKit reads the pair as YAML, and a ' stops
# it from starting. Letters and digits (e.g. `openssl rand -hex 32`) are safest.
LIVEKIT_API_KEY=change-me-api-key
LIVEKIT_API_SECRET=change-me-api-secret-must-be-at-least-32-characters
