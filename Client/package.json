{
  "name": "owncord-client",
  "private": true,
  "version": "1.2.0-alpha.4",
  "type": "module",
  "engines": {
    "node": "^26",
    "npm": "^11"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail --error-on-warn",
    "dev": "npm run dev:desktop",
    "dev:desktop": "vite --config vite.config.desktop.ts",
    "build": "npm run build:desktop",
    "build:desktop": "tsc -p tsconfig.build.json && vite build --config vite.config.desktop.ts",
    "build:budget": "vite build --config vite.config.desktop.ts --manifest --outDir dist-budget --emptyOutDir",
    "check:budgets": "node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test --config playwright.config.prod.ts",
    "test:e2e:smoke": "playwright test --config playwright.config.smoke.ts",
    "test:e2e:native": "playwright test --config playwright.config.native.ts",
    "test:e2e:native-voice": "playwright test --config playwright.config.native-voice.ts",
    "test:e2e:artifact": "playwright test --config playwright.config.artifact.ts",
    "test:e2e:admin": "npm run test:e2e:build-server && playwright test --config playwright.config.admin.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint": "npm run lint:ox && npm run lint:cycles && eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:ox": "oxlint --deny-warnings src/",
    "lint:cycles": "oxlint -c .oxlintrc.cycles.json --tsconfig tsconfig.json --max-warnings=0 src/",
    "knip": "knip",
    "test:mutate": "stryker run",
    "test:mutate:dry": "stryker run --dryRunOnly",
    "test:e2e:build-server": "node tests/e2e/scripts/build-server.mjs",
    "test:e2e:fullstack": "npm run test:e2e:build-server && npm run build && playwright test --config playwright.config.fullstack.ts",
    "test:e2e:soak": "npm run test:e2e:build-server && npm run build && playwright test --config playwright.config.soak.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.1",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.83.0",
    "patch-package": "8.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "livekit-client": "2.22.3"
  },
  "overrides": {
    "qs": "^6.15.3",
    "test-exclude": "^8.0.0"
  }
}
