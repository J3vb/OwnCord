{
  // Type checks the admin panel (Server/admin/static/js), which is Server-owned
  // and therefore absent from every other tsconfig here. It is compiled with a
  // deliberately loose, non-strict program: turning strict on would bury the
  // signal in DOM-typing noise. The panel is clean under it: the shrink-only
  // scripts/admin-types-baseline.json is empty, so any checkJs error fails, and
  // an undefined global (TS2304/TS2552) fails whatever the baseline says.
  // Driven by scripts/check-admin-types.mjs, not a bare `tsc -p`.
  //
  // Not an extension of tsconfig.json: the panel is classic scripts sharing one
  // global scope, has no src/ paths, and must not inherit `strict`,
  // `noUncheckedIndexedAccess` or the `@lib/*` aliases.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["../Server/admin/static/js/**/*.js"]
}
