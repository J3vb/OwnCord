      { "wire": "INVALID_JSON", "go": "ErrCodeInvalidJSON", "ts": "INVALID_JSON" },
      { "wire": "UNKNOWN_TYPE", "go": "ErrCodeUnknownType", "ts": "UNKNOWN_TYPE" },
      { "wire": "SLOW_MODE", "go": "ErrCodeSlowMode", "ts": "SLOW_MODE" },
      { "wire": "CONFLICT", "go": "ErrCodeConflict", "ts": "CONFLICT" },
