        "wire": "ATTACHMENTS_UNAVAILABLE",
        "go": "ErrCodeAttachmentsUnavailable",
        "ts": "ATTACHMENTS_UNAVAILABLE",
        "note": "Refines BAD_REQUEST: a send with no text whose every attachment was skipped. Nothing was stored."
      },
      {
        "wire": "REACTION_LIMIT",
        "go": "ErrCodeReactionLimit",
        "ts": "REACTION_LIMIT",
        "note": "Refines BAD_REQUEST: a new emoji on a message that already holds 20 different ones. No reaction_update is sent."
      },
      {
        "wire": "POLL_ENDED",
        "go": "ErrCodePollEnded",
        "ts": "POLL_ENDED",
        "note": "Refines BAD_REQUEST: a poll_vote or poll_end on a poll that was already ended or whose time ran out. Nothing was written and no poll_update is sent for the refused command."
      },
      {
        "wire": "STICKER_NOT_FOUND",
        "go": "ErrCodeStickerNotFound",
        "ts": "STICKER_NOT_FOUND",
        "note": "Refines NOT_FOUND: a chat_send named a sticker that does not exist, or was deleted. Nothing was stored, and the client refreshes its picker from sticker_update."
      },
      {
        "wire": "ALREADY_DELETED",
        "go": "ErrCodeAlreadyDeleted",
        "ts": "ALREADY_DELETED",
        "note": "The WS twin of REST's 409 ALREADY_DELETED: the same \"already in the requested end state\" refusal, so a client sees one code for the state rather than FORBIDDEN over WS and ALREADY_DELETED over REST (F23)."
      },
      { "wire": "BAD_PAYLOAD", "go": "ErrCodeBadPayload", "ts": "BAD_PAYLOAD" },
      { "wire": "NOT_KEY_HOLDER", "go": "ErrCodeNotKeyHolder", "ts": "NOT_KEY_HOLDER" },
      {
        "wire": "SERVER_MUTED",
        "go": "ErrCodeServerMuted",
        "ts": "SERVER_MUTED",
        "note": "Returned when a user tries to lift a moderator-imposed voice mute."
      },
      {
        "wire": "SERVER_DEAFENED",
        "go": "ErrCodeServerDeafened",
        "ts": "SERVER_DEAFENED",
        "note": "Returned when a user tries to lift a moderator-imposed voice deafen."
      },
      {
        "wire": "TIMED_OUT",
        "go": "ErrCodeTimedOut",
        "ts": "TIMED_OUT",
        "note": "Returned for a send, edit, reaction, voice join, call ring or custom status refused by an active moderator timeout (B5-9)."
      },
      {
        "wire": "CALL_REQUIRES_ACCEPTANCE",
        "go": "ErrCodeCallRequiresAcceptance",
        "ts": "CALL_REQUIRES_ACCEPTANCE",
        "note": "Answers a 1:1 call_ring whose recipient has not accepted the caller's message request. One code for every untrusted state, so it reveals nothing the caller's own request does not; the ring is never delivered (DM call review D-03)."
      },
      {
        "wire": "SESSION_REPLACED",
        "go": "ErrCodeSessionReplaced",
        "ts": "SESSION_REPLACED",
        "note": "Sent to a connection the hub displaces because the same device session reconnected (F5, network drop, wake), or because the account is over its per-user connection cap. The client stops reconnecting on it; without it the displaced device cannot tell the close from a network drop and the two devices trade the socket forever."
      },
      {
        "wire": "ANOTHER_DEVICE_ACTIVE",
        "go": "ErrCodeAnotherDeviceActive",
        "ts": "ANOTHER_DEVICE_ACTIVE",
        "note": "Kept for wire compatibility only: the server no longer sends it, because several device sessions of one account now stay connected at once. Older servers sent it to a wake reconnect refused while another session held the connection, and clients still handle it."
      },
      {
        "wire": "SERVER_BUSY",
        "go": "ErrCodeServerBusy",
        "ts": "SERVER_BUSY",
        "note": "Refuses a fresh connect that waited readyAdmissionWait for a ready-build permit (P5-S04). It carries retry_after_ms, and the socket closes 1013 right after; the client redials no sooner."
      },
      {
        "wire": "REQUEST_TIMEOUT",
        "go": "ErrCodeRequestTimeout",
        "ts": "REQUEST_TIMEOUT",
        "note": "Answers a command whose database work ran past the per-frame deadline (command_deadline.go, WP 4.1b). It means \"not applied\": the command was cut short before its commit, so a retry is safe. It is not SERVER_BUSY, which the client treats as a refused connect and redials on."
      },
      {
        "wire": "THREAD_EXISTS",
        "go": "ErrCodeThreadExists",
        "ts": "THREAD_EXISTS",
        "note": "Answers a thread_create for a message that already has a thread (WP 6.9c). The payload carries thread_id, the existing thread, so the client opens it instead of failing."
      },
      {
        "wire": "THREAD_LOCKED",
        "go": "ErrCodeThreadLocked",
        "ts": "THREAD_LOCKED",
        "note": "Refines FORBIDDEN: the thread is locked and only a moderator (MANAGE_MESSAGES) may post, react, pin or change it."
      },
      {
        "wire": "GAME_ACTIVITY_DISABLED",
        "go": "ErrCodeGameActivityDisabled",
        "ts": "GAME_ACTIVITY_DISABLED",
        "note": "Answers an activity_update that sets a game while an admin has turned game activity off for the server (WP 8.3e-2). A clear is never refused. The client claims it without a toast and does not resend until the game changes."
      },
      {
        "wire": "protocol_epoch_unsupported",
        "go": "ErrCodeProtocolEpoch",
        "ts": "protocol_epoch_unsupported",
        "note": "The auth_error code (not an error frame) for a client whose wire epoch this server does not speak. Lower case, unlike the rest, because it shipped that way."
      }
    ]
  }
