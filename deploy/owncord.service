# OwnCord server — systemd unit template.
#
# Install:
#   1. Create a service user. Its home is the state directory, which systemd
#      creates and owns (StateDirectory=owncord, /var/lib/owncord):
#        sudo useradd --system --home /var/lib/owncord --shell /usr/sbin/nologin owncord
#   2. Install the chatserver binary (from GitHub Releases), owned by root:
#        sudo install -d -o root -g root -m 0755 /opt/owncord
#        sudo install -o root -g root -m 0755 ./chatserver /opt/owncord/chatserver
#   3. sudo cp deploy/owncord.service /etc/systemd/system/owncord.service
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now owncord
#
# Config, database, uploads and certificates live in /var/lib/owncord
# (config.yaml, data/); the program in /opt/owncord is read-only to the service.
#
# Upgrading from the old layout (state under /opt/owncord)? Read "Migrating
# from the /opt/owncord data layout" in docs/deployment.md first.
#
# Logs: journalctl -u owncord -f

[Unit]
Description=OwnCord chat server
After=network-online.target
Wants=network-online.target
# Refuse to start while the old layout's data still sits under /opt/owncord, so
# a server never boots into an empty state directory. Move it first: see
# "Migrating from the /opt/owncord data layout" in docs/deployment.md.
AssertPathExists=!/opt/owncord/data

[Service]
Type=simple
User=owncord
Group=owncord
WorkingDirectory=/var/lib/owncord
# systemd creates /var/lib/owncord owned by User=, and keeps it writable under
# ProtectSystem=strict. Config, database, uploads and certificates live here.
# Do not add NoExecPaths= for it: the bundled LiveKit runs from data/livekit/.
StateDirectory=owncord
StateDirectoryMode=0750
ExecStart=/opt/owncord/chatserver
# always, not on-failure: the server exits 0 ON PURPOSE after an admin-panel
# self-update, backup restore, or setup-wizard change, expecting systemd to
# relaunch it (now running the swapped binary). `systemctl stop` is unaffected
# — systemd never auto-restarts an explicitly stopped unit. Failure exits
# (e.g. the WebSocket dispatch panic breaker, exit 1) restart the same as
# they did under on-failure.
Restart=always
RestartSec=3
# RestartSec=3 means at most 4 starts fit in systemd's default 10s start-limit
# window, so the default burst of 5 is never reached and a crash loop restarts
# forever instead of parking the unit as failed. To make a crash loop trip the
# limit, set StartLimitBurst to 3 (≤ the 4 starts that fit in the window).

# The server drains gracefully on SIGTERM: up to 30s for the HTTP drain, up
# to 10s for each other shutdown step, and the whole teardown capped at 50s;
# 60s waits that out. Past 60s systemd SIGKILLs a wedged
# teardown — non-systemd supervisors are covered by the server's own 90s
# restart backstop (RestartBackstopDelay).
TimeoutStopSec=60

# Open-file limit. Each WebSocket holds a descriptor. The Go runtime already
# lifts the SOFT limit to just under the HARD one at init, and the server
# raises it the rest of the way, so this hard limit is the real ceiling. The
# risk is a low hard limit (an old systemd default of 1,024, say), which a few
# hundred online will reach. 65,536 is well above what 2,000 online need (the
# server's 2×cap+256 boot budget for 2,000 is 4,256); raise it (or use
# `infinity`) only past roughly 30,000 connections.
LimitNOFILE=65536

# ── Hardening ───────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The program in /opt/owncord is root-owned and read-only to the service; only
# the state directory (StateDirectory= above) is writable.
#
# ProtectSystem=strict makes the REST of the filesystem read-only, so any
# directory the server writes to outside /var/lib/owncord must be listed here
# or that write fails with EROFS — including the documented off-disk
# backup.dir and upload.storage_dir. Add a line like the example below for
# each extra path you configure:
#   ReadWritePaths=/mnt/backup-disk/owncord
#
# Admin-panel self-update is opt-in. To enable it, add a drop-in
# (systemctl edit owncord) containing "[Service]" and
# "ReadWritePaths=/opt/owncord", and chown the folder to owncord. See "Opt in
# to admin-panel updates" in docs/deployment.md.

# Only needed for tls.mode: acme, which binds :80 for HTTP-01 challenges
# (Server/internal/app/http.go, startACMEServer) as a non-root user. Uncomment
# it if you use tls.mode: acme.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
