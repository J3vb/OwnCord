{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "owncord-introspect": {
      "command": "node",
      "args": ["tools/mcp-introspect/index.mjs"],
      "env": {
        "OWNCORD_API_TOKEN": "${OWNCORD_API_TOKEN}"
      }
    }
  }
}
